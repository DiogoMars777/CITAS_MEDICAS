frame "sd CU01 Iniciar y cerrar sesión" {
    () " " as spacer
    actor "Usuario / Administrador" as UsuarioActor
    boundary UI_Sesion
    control CU01_AuthController
    entity Usuario
    entity BitacoraAuditoria

    spacer -[hidden]down- UsuarioActor

    UsuarioActor -right- UI_Sesion : <font color=#000000>1: iniciarSesion(login, password) →</font>\n<font color=#800000>2: solicitarRecuperacion(email) →</font>\n<font color=#008000>3: verificarOtp(email, otp) →</font>\n<font color=#000080>4: restablecerPassword(datos) →</font>\n<font color=#800080>5: cerrarSesion() →</font>

    UI_Sesion -right- CU01_AuthController : <font color=#000000>1.1: login(Request) →</font>\n<font color=#800000>2.1: forgotPassword(Request) →</font>\n<font color=#008000>3.1: verifyOtp(Request) →</font>\n<font color=#000080>4.1: resetPassword(Request) →</font>\n<font color=#800080>5.1: logout(Request) →</font>

    CU01_AuthController -right- Usuario : <font color=#000000>1.2: whereRaw('LOWER(email) = ?')->orWhereRaw()->first() →</font>\n<font color=#000000>1.3: update(['ultimo_login' => now()]) →</font>\n<font color=#800000>2.2: whereRaw('LOWER(email) = ?')->first() →</font>\n<font color=#000080>4.2: update(['password_hash' => hash]) →</font>\n<font color=#800080>5.2: currentAccessToken()->delete() →</font>

    CU01_AuthController -down- BitacoraAuditoria : <font color=#000000>1.4: registrar('PKG01_Seguridad', 'usuarios', id, 'LOGIN') →</font>\n<font color=#800080>5.3: registrar('PKG01_Seguridad', 'usuarios', id, 'LOGOUT') →</font>
}
@enduml

